<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#18243B" android:endColor="#121A29" android:angle="0"/>
            <stroke android:width="2dp" android:color="#6EA0FF"/>
            <corners android:radius="17dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#151D2B" android:endColor="#101621" android:angle="0"/>
            <stroke android:width="1dp" android:color="#27344A"/>
            <corners android:radius="17dp"/>
        </shape>
    </item>
</selector>
