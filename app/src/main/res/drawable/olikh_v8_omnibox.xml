<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#171820"/>
            <stroke android:width="2dp" android:color="#A78BFA"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#15161C"/>
            <stroke android:width="1dp" android:color="#292B35"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</selector>
