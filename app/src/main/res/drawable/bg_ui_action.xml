<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2A3040"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#58657A"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#171B23"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#303847"/>
        </shape>
    </item>
</selector>
