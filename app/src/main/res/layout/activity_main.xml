<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#090B10">

        <!-- Premium top chrome -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/olikhChromeBrand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OLIKH"
                android:textColor="#F5F7FB"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.16"
                android:fontFamily="sans" />

            <Button
                android:id="@+id/btnTabs"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_modern_icon"
                android:text="1"
                android:textColor="#E8ECF4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:contentDescription="Tabs" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_more_vertical"
                android:tint="#D7DDE8"
                android:padding="9dp"
                android:contentDescription="Menu" />
        </LinearLayout>

        <!-- Premium omnibox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_modern_omnibox"
            android:paddingStart="13dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:tint="#8F98A8"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:background="@android:color/transparent"
                android:hint="Search or enter address"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:ellipsize="middle"
                android:scrollHorizontally="true"
                android:textColor="#F5F7FB"
                android:textColorHint="#778194"
                android:textSize="14sp"
                android:padding="0dp"
                android:selectAllOnFocus="true" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_reload"
                android:tint="#DDE2EA"
                android:padding="9dp"
                android:contentDescription="Reload" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progressTint="#7187FF"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/browserContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="1dp"
            android:background="#090B10">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Premium bottom dock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:background="@drawable/bg_modern_bottom">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_back"
                android:tint="#D8DEE8"
                android:padding="10dp"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_forward"
                android:tint="#D8DEE8"
                android:padding="10dp"
                android:contentDescription="Forward" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_home"
                android:tint="#D8DEE8"
                android:padding="10dp"
                android:contentDescription="Home" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_history"
                android:tint="#D8DEE8"
                android:padding="10dp"
                android:contentDescription="History" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_bookmark"
                android:tint="#D8DEE8"
                android:padding="10dp"
                android:contentDescription="Bookmarks" />

            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_modern_accent"
                android:src="@drawable/ic_add"
                android:tint="#FFFFFF"
                android:padding="11dp"
                android:contentDescription="New tab" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
