<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 100% Immersive Edge-to-Edge Web Canvas -->
    <FrameLayout
        android:id="@+id/browserContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />
    </FrameLayout>

    <!-- Top Glow Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="#38BDF8"
        android:visibility="gone" />

    <!-- Floating Dynamic Island Capsule (Bottom Center) -->
    <LinearLayout
        android:id="@+id/floatingCapsule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_capsule"
        android:elevation="12dp">

        <!-- Navigation: Back -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_capsule_pill"
            android:src="@drawable/ic_back"
            app:tint="#94A3B8"
            android:padding="9dp"
            android:contentDescription="Back" />

        <!-- Center Dynamic Address / Command Bar -->
        <LinearLayout
            android:id="@+id/addressBarContainer"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_capsule_pill"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/sslLockIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="#38BDF8"
                android:contentDescription="Status" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"
                android:hint="Search or jump to URL..."
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="13sp"
                android:padding="0dp"
                android:selectAllOnFocus="true"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_reload"
                app:tint="#94A3B8"
                android:padding="5dp"
                android:contentDescription="Reload" />
        </LinearLayout>

        <!-- Tab Switcher Badge Button -->
        <Button
            android:id="@+id/btnTabs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/bg_capsule_pill"
            android:text="1"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:contentDescription="Tabs" />

        <!-- Quick Action Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_capsule_pill"
            android:src="@drawable/ic_more_vertical"
            app:tint="#94A3B8"
            android:padding="9dp"
            android:contentDescription="Menu" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
