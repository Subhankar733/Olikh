<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#090B10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnTabs"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_modern_icon"
                android:text="1"
                android:textColor="#E8ECF4"
                android:textSize="10sp"
                android:textStyle="bold"
                android:contentDescription="Tabs" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_more_vertical"
                app:tint="#D7DDE8"
                android:padding="8dp"
                android:contentDescription="Menu" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_modern_omnibox"
            android:paddingStart="12dp"
            android:paddingEnd="5dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="#8E98A9"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Search or enter address"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:ellipsize="middle"
                android:scrollHorizontally="true"
                android:textColor="#F5F7FB"
                android:textColorHint="#737D8E"
                android:textSize="14sp"
                android:padding="0dp"
                android:selectAllOnFocus="true" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_reload"
                app:tint="#DDE2EA"
                android:padding="9dp"
                android:contentDescription="Reload" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="#7187FF"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/browserContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#090B10">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="@drawable/bg_modern_bottom">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_back"
                app:tint="#D8DEE8"
                android:padding="10dp"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_forward"
                app:tint="#D8DEE8"
                android:padding="10dp"
                android:contentDescription="Forward" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_modern_icon"
                android:src="@drawable/ic_home"
                app:tint="#D8DEE8"
                android:padding="10dp"
                android:contentDescription="Home" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_modern_accent"
                android:src="@drawable/ic_add"
                app:tint="#FFFFFF"
                android:padding="11dp"
                android:contentDescription="New tab" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
