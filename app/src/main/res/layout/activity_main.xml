<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0D10">

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone"/>

    <FrameLayout
        android:id="@+id/browserContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </FrameLayout>

    <!-- Bottom omnibox -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:background="#0B0D10">

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/olikh_omnibox"
            android:hint="Search or enter address"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#F5F7FA"
            android:textColorHint="#8D949E"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnTabs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/olikh_tab_badge"
            android:contentDescription="Open tabs"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="1"
            android:textAllCaps="false"
            android:textColor="#F5F7FA"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/olikh_icon_button"
            android:contentDescription="Browser menu"
            android:padding="9dp"
            android:src="@drawable/ic_more"/>

    </LinearLayout>

    <!-- Compact navigation dock -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:background="#0B0D10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/olikh_toolbar"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/olikh_icon_button"
                android:contentDescription="Back"
                android:padding="11dp"
                android:src="@drawable/ic_back"/>

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/olikh_icon_button"
                android:contentDescription="Forward"
                android:padding="11dp"
                android:src="@drawable/ic_forward"/>

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/olikh_icon_button"
                android:contentDescription="Home"
                android:padding="11dp"
                android:src="@drawable/ic_home"/>

            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/olikh_icon_button"
                android:contentDescription="New tab"
                android:padding="11dp"
                android:src="@drawable/ic_add"/>

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/olikh_icon_button"
                android:contentDescription="Add bookmark"
                android:padding="11dp"
                android:src="@drawable/ic_bookmark"/>

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/olikh_icon_button"
                android:contentDescription="Reload"
                android:padding="11dp"
                android:src="@drawable/ic_reload"/>

            <!-- Kept for existing History listener, hidden from primary UI -->
            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible"
                android:background="@android:color/transparent"
                android:contentDescription="History"
                android:src="@drawable/ic_history"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
