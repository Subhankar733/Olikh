<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B0D12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:background="@drawable/bg_ui_shell">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ui_action"
                android:src="@drawable/ic_olikh_chevron_down"
                android:tint="#E8ECF4"
                android:padding="11dp"
                android:contentDescription="Browser menu" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_url_bar"
                android:hint="Search or enter address"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:includeFontPadding="false"
                android:textColor="#F4F6FA"
                android:textColorHint="#8C95A6"
                android:textSize="14sp"
                android:selectAllOnFocus="true" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ui_action"
                android:src="@drawable/ic_reload"
                android:tint="#E8ECF4"
                android:padding="11dp"
                android:contentDescription="Reload" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="18dp"
            android:max="100"
            android:progressTint="#7187FF"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/browserContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:background="#0B0D12">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:background="@drawable/bg_ui_shell">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ui_action"
                android:src="@drawable/ic_back"
                android:tint="#DCE1EB"
                android:padding="11dp"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ui_action"
                android:src="@drawable/ic_forward"
                android:tint="#DCE1EB"
                android:padding="11dp"
                android:contentDescription="Forward" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ui_action"
                android:src="@drawable/ic_home"
                android:tint="#C7CFDE"
                android:padding="11dp"
                android:contentDescription="Home" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ui_action"
                android:src="@drawable/ic_history"
                android:tint="#C7CFDE"
                android:padding="11dp"
                android:contentDescription="History" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ui_action"
                android:src="@drawable/ic_bookmark"
                android:tint="#C7CFDE"
                android:padding="11dp"
                android:contentDescription="Bookmark" />

            <Button
                android:id="@+id/btnTabs"
                android:layout_width="46dp"
                android:layout_height="44dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_tab_button"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:contentDescription="Open tabs" />

            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_ui_plus"
                android:src="@drawable/ic_add"
                android:tint="#FFFFFF"
                android:padding="11dp"
                android:contentDescription="New tab" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
