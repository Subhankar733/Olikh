<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1016">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D1016">

        <!-- Compact browser header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="#0D1016">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_olikh_chevron_down"
                android:tint="#E8ECF4"
                android:padding="11dp"
                android:contentDescription="Browser menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_browser_address"
                android:paddingStart="13dp"
                android:paddingEnd="5dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="◉"
                    android:textColor="#7D8FFF"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/addressBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search or type a URL"
                    android:inputType="textUri"
                    android:imeOptions="actionGo"
                    android:singleLine="true"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:includeFontPadding="false"
                    android:textColor="#F3F5F9"
                    android:textColorHint="#7E8797"
                    android:textSize="14sp"
                    android:selectAllOnFocus="true" />

                <ImageButton
                    android:id="@+id/btnReload"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_browser_button"
                    android:src="@drawable/ic_reload"
                    android:tint="#DDE2EC"
                    android:padding="9dp"
                    android:contentDescription="Reload" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="#7D8FFF"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/browserContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0D1016">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Browser navigation dock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="#0D1016">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_back"
                android:tint="#DCE1EB"
                android:padding="10dp"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_forward"
                android:tint="#DCE1EB"
                android:padding="10dp"
                android:contentDescription="Forward" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_home"
                android:tint="#DCE1EB"
                android:padding="10dp"
                android:contentDescription="Home" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_history"
                android:tint="#DCE1EB"
                android:padding="10dp"
                android:contentDescription="History" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_bookmark"
                android:tint="#DCE1EB"
                android:padding="10dp"
                android:contentDescription="Bookmark" />

            <Button
                android:id="@+id/btnTabs"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_browser_tab"
                android:gravity="center"
                android:text="1"
                android:textColor="#11151D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:contentDescription="Open tabs" />

            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_browser_newtab"
                android:src="@drawable/ic_add"
                android:tint="#FFFFFF"
                android:padding="10dp"
                android:contentDescription="New tab" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
