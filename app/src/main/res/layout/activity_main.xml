<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#080A0D">

        <!-- OLIKH browser chrome: clean, flat, two-level toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:background="#080A0D">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_olikh_chevron_down"
                android:tint="#E9EDF5"
                android:padding="10dp"
                android:contentDescription="Browser menu" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_browser_address"
                android:hint="Search or enter address"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:includeFontPadding="false"
                android:textColor="#F4F6FA"
                android:textColorHint="#7E8796"
                android:textSize="14sp"
                android:selectAllOnFocus="true" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_reload"
                android:tint="#E9EDF5"
                android:padding="10dp"
                android:contentDescription="Reload" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="#7387FF"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/browserContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#080A0D">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Bottom browser navigation rail -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#080A0D">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_back"
                android:tint="#D9DFEA"
                android:padding="10dp"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_forward"
                android:tint="#D9DFEA"
                android:padding="10dp"
                android:contentDescription="Forward" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_home"
                android:tint="#D9DFEA"
                android:padding="10dp"
                android:contentDescription="Home" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_history"
                android:tint="#D9DFEA"
                android:padding="10dp"
                android:contentDescription="History" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_browser_button"
                android:src="@drawable/ic_bookmark"
                android:tint="#D9DFEA"
                android:padding="10dp"
                android:contentDescription="Bookmark" />

            <Button
                android:id="@+id/btnTabs"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_browser_tab"
                android:gravity="center"
                android:text="1"
                android:textColor="#10131A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:contentDescription="Open tabs" />

            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_browser_newtab"
                android:src="@drawable/ic_add"
                android:tint="#FFFFFF"
                android:padding="10dp"
                android:contentDescription="New tab" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
