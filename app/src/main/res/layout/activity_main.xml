<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080B12">

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressTint="#5B8CFF"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/olikh_modern_omnibox"
            android:hint="Search or enter address"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:textColor="#F8FAFF"
            android:textColorHint="#7F899C"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnTabs"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/olikh_modern_tab"
            android:contentDescription="Open tabs"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="1"
            android:textAllCaps="false"
            android:textColor="#F8FAFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/olikh_modern_button"
            android:contentDescription="Browser menu"
            android:padding="10dp"
            android:src="@drawable/ic_more"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/browserContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#080B12">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#0B1019"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/olikh_modern_button"
            android:contentDescription="Back"
            android:padding="13dp"
            android:src="@drawable/ic_back"/>

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/olikh_modern_button"
            android:contentDescription="Forward"
            android:padding="13dp"
            android:src="@drawable/ic_forward"/>

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/olikh_modern_button"
            android:contentDescription="Home"
            android:padding="13dp"
            android:src="@drawable/ic_home"/>

        <ImageButton
            android:id="@+id/btnNewTab"
            android:layout_width="58dp"
            android:layout_height="50dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/olikh_modern_primary"
            android:contentDescription="New tab"
            android:elevation="7dp"
            android:padding="13dp"
            android:src="@drawable/ic_add"/>

        <ImageButton
            android:id="@+id/btnBookmark"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/olikh_modern_button"
            android:contentDescription="Bookmark"
            android:padding="13dp"
            android:src="@drawable/ic_bookmark"/>

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/olikh_modern_button"
            android:contentDescription="Reload"
            android:padding="13dp"
            android:src="@drawable/ic_reload"/>

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            android:background="@android:color/transparent"
            android:contentDescription="History"
            android:src="@drawable/ic_history"/>
    </LinearLayout>
</LinearLayout>
